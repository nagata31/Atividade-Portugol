//15 questao 

programa{
  funcao inicio(){

    real produto_preco = 30.55
    real desconto_produto
    escreva("o protudo com  o valor de ", produto_preco, " recebera o desconto de 15% \n")
    desconto_produto = produto_preco * 15 /100
    escreva("o produto com desconto ficara com este preço \n", "preço anterior: ", produto_preco, "\n", "com o desconto: ", desconto_produto)
    

  }
}

