//17 questao

programa{
  funcao inicio(){

//algoritmo "Troca_Valores"

//var
   inteiro A, B, aux

//inicio

   escreva("Digite o valor de A: ")
   leia(A)

   escreva("Digite o valor de B: ")
   leia(B)

   escreva("\nAntes da troca:")
   escreva("\nA = ", A)
   escreva("\nB = ", B)

   aux = A
   A = B
   B = aux

   escreva("\n\nDepois da troca:")
   escreva("\nA = ", A)
   escreva("\nB = ", B)

//fimalgoritmo

    
  }
}

